{
  "$defs": {
    "Period": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "Period",
      "type": "object"
    }
  },
  "$id": "https://atra.local/schemas/tools/ahdt.data.observations.args.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "aggregate": {
      "default": "raw",
      "enum": [
        "raw",
        "1m",
        "5m",
        "1h"
      ],
      "title": "Aggregate",
      "type": "string"
    },
    "as_of": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "As Of"
    },
    "codes": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Codes",
      "type": "array"
    },
    "hdt_id": {
      "pattern": "^hdt-[0-9a-f]{12}$",
      "title": "Hdt Id",
      "type": "string"
    },
    "period": {
      "anyOf": [
        {
          "$ref": "#/$defs/Period"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "hdt_id",
    "codes"
  ],
  "title": "ObservationsArgs",
  "type": "object"
}
