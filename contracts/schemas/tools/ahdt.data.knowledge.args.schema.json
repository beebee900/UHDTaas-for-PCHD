{
  "$id": "https://atra.local/schemas/tools/ahdt.data.knowledge.args.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "as_of": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "As Of"
    },
    "hdt_id": {
      "pattern": "^hdt-[0-9a-f]{12}$",
      "title": "Hdt Id",
      "type": "string"
    },
    "params": {
      "additionalProperties": true,
      "title": "Params",
      "type": "object"
    },
    "query_id": {
      "title": "Query Id",
      "type": "string"
    }
  },
  "required": [
    "hdt_id",
    "query_id",
    "params"
  ],
  "title": "KnowledgeArgs",
  "type": "object"
}
