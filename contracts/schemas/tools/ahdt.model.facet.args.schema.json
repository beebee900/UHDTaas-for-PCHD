  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "anatomy": {
      "title": "Anatomy",
      "type": "string"
    },
    "facet": {
      "title": "Facet",
      "type": "string"
    },
    "hdt_id": {
      "pattern": "^hdt-[0-9a-f]{12}$",
