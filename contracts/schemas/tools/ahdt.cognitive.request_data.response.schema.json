{
  "$id": "https://atra.local/schemas/tools/ahdt.cognitive.request_data.response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "sent",
        "answered",
        "expired"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "status"
  ],
  "title": "RequestDataData",
  "type": "object"
}
