{
  "$id": "https://atra.local/schemas/tools/ahdt.data.graph_query.args.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "as_of": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "As Of"
    },
    "hdt_id": {
      "pattern": "^hdt-[0-9a-f]{12}$",
      "title": "Hdt Id",
      "type": "string"
    },
    "mode": {
      "default": "hybrid",
      "enum": [
        "graphrag",
        "vector",
        "chunkless",
        "hybrid"
      ],
      "title": "Mode",
      "type": "string"
    },
    "question": {
      "minLength": 1,
      "title": "Question",
      "type": "string"
    }
  },
  "required": [
    "hdt_id",
    "question"
  ],
  "title": "GraphQueryArgs",
  "type": "object"
}
