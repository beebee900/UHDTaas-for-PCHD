{
  "$defs": {
    "DTKind": {
      "description": "The 17 peer DTs of the federated Human Digital Twin, plus the Patient DT (APDT).",
      "enum": [
        "cardiovascular",
        "respiratory",
        "nervous",
        "sensory",
        "digestive",
        "hepatobiliary",
        "renal_urinary",
        "endocrine",
        "immune_lymphatic",
        "haematological",
        "musculoskeletal",
        "integumentary",
        "reproductive",
        "whole_body",
        "behavioural_cognitive",
        "social",
        "population",
        "patient"
      ],
      "title": "DTKind",
      "type": "string"
    }
  },
  "$id": "https://atra.local/schemas/tools/ahdt.model.state.response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "dt": {
      "$ref": "#/$defs/DTKind"
    },
    "output_id": {
      "title": "Output Id",
      "type": "string"
    },
    "state": {
      "additionalProperties": true,
      "title": "State",
      "type": "object"
    },
    "status": {
      "enum": [
        "normal",
        "watch",
        "alert"
      ],
      "title": "Status",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "dt",
    "state",
    "status",
    "updated_at",
    "output_id"
  ],
  "title": "StateData",
  "type": "object"
}
