              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adherence"
        },
        "atc": {
          "title": "Atc",
          "type": "string"
        },
        "display": {
          "title": "Display",
          "type": "string"
        },
        "dose": {
          "title": "Dose",
          "type": "string"
        },
        "end": {
