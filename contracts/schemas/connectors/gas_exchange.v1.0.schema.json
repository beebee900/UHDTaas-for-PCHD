{
  "$id": "https://atra.local/schemas/connectors/gas_exchange/v1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "paco2": {
      "maximum": 150,
      "minimum": 10,
      "type": "number",
      "x-ucum": "mm[Hg]"
    },
    "pao2": {
      "maximum": 600,
      "minimum": 20,
      "type": "number",
      "x-ucum": "mm[Hg]"
    },
    "respiratory_rate": {
      "maximum": 70,
      "minimum": 4,
      "type": "number",
      "x-ucum": "/min"
    },
    "spo2": {
      "maximum": 100,
      "minimum": 50,
      "type": "number",
      "x-ucum": "%"
    }
  },
  "required": [
    "spo2",
    "respiratory_rate"
  ],
  "title": "gas_exchange v1.0",
  "type": "object"
}
