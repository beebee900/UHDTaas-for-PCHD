{
  "$id": "https://atra.local/schemas/connectors/connector_envelope.v1.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A connector message on the wire (`Message.to_bytes`).",
  "properties": {
    "contract": {
      "pattern": "^[a-z0-9_]+/v[0-9]+\\.[0-9]+$",
      "title": "Contract",
      "type": "string"
    },
    "correlation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "msg_id": {
      "title": "Msg Id",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "provenance": {
      "additionalProperties": true,
      "description": "connector_id, connector, models, content_hash, hlc, prov_id",
      "title": "Provenance",
      "type": "object"
    },
    "purpose": {
      "title": "Purpose",
      "type": "string"
    },
    "reply_to": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reply To"
    },
    "seq": {
      "minimum": 0,
      "title": "Seq",
      "type": "integer"
    },
    "sim_time": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sim Time"
    },
    "source": {
      "description": "TwinEndpoint URI hdt://<hdt_id>/<kind>/<instance>",
      "title": "Source",
      "type": "string"
    },
    "target": {
      "title": "Target",
      "type": "string"
    },
    "trace_id": {
      "title": "Trace Id",
      "type": "string"
    },
    "units": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "description": "UCUM unit per payload field",
      "title": "Units",
      "type": "object"
    },
    "wall_time": {
      "title": "Wall Time",
      "type": "number"
    }
  },
  "required": [
    "source",
    "target",
    "contract",
    "payload",
    "units",
    "wall_time",
    "msg_id",
    "trace_id",
    "purpose",
    "provenance",
    "seq"
  ],
  "title": "ConnectorEnvelope",
  "type": "object"
}
