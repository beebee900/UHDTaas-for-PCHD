{
  "$id": "https://atra.local/schemas/connectors/haemodynamics/v1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cardiac_output": {
      "maximum": 40,
      "minimum": 0.5,
      "type": "number",
      "x-ucum": "L/min"
    },
    "heart_rate": {
      "maximum": 250,
      "minimum": 20,
      "type": "number",
      "x-ucum": "/min"
    },
    "mean_arterial_pressure": {
      "maximum": 200,
      "minimum": 20,
      "type": "number",
      "x-ucum": "mm[Hg]"
    }
  },
  "required": [
    "cardiac_output",
    "heart_rate",
    "mean_arterial_pressure"
  ],
  "title": "haemodynamics v1.0",
  "type": "object"
}
