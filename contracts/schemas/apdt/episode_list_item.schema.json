{
  "$defs": {
    "CareTeamMember": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/Role"
        }
      },
      "required": [
        "id",
        "role"
      ],
      "title": "CareTeamMember",
      "type": "object"
    },
    "Episode": {
      "additionalProperties": false,
      "properties": {
        "care_team": {
          "items": {
            "$ref": "#/$defs/CareTeamMember"
          },
          "title": "Care Team",
          "type": "array"
        },
        "closed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Closed At"
        },
        "episode_id": {
          "title": "Episode Id",
          "type": "string"
        },
        "goal_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Goal Text"
        },
        "hdt_id": {
          "title": "Hdt Id",
          "type": "string"
        },
        "opened_at": {
          "format": "date-time",
          "title": "Opened At",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "responsible_clinician": {
          "title": "Responsible Clinician",
          "type": "string"
        },
        "status": {
          "enum": [
            "open",
            "closed"
          ],
          "title": "Status",
          "type": "string"
        },
        "tenant_id": {
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "episode_id",
        "tenant_id",
        "hdt_id",
        "status",
        "opened_at",
        "reason",
        "responsible_clinician"
      ],
      "title": "Episode",
      "type": "object"
    },
    "PatientEntry": {
      "additionalProperties": false,
      "description": "A patient of a facility, as the demo patient directory lists them.",
      "properties": {
        "age_years": {
          "minimum": 0,
          "title": "Age Years",
          "type": "integer"
        },
        "hdt_id": {
          "title": "Hdt Id",
          "type": "string"
        },
        "initials": {
          "title": "Initials",
          "type": "string"
        },
        "language": {
          "enum": [
            "en",
            "yo",
            "ha",
            "ig",
            "pcm"
          ],
          "title": "Language",
          "type": "string"
        },
        "sex": {
          "enum": [
            "female",
            "male"
          ],
          "title": "Sex",
          "type": "string"
        },
        "tenant_id": {
          "enum": [
            "fac-a",
            "fac-b"
          ],
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "hdt_id",
        "initials",
        "sex",
        "age_years",
        "language",
        "tenant_id"
      ],
      "title": "PatientEntry",
      "type": "object"
    },
    "Role": {
      "enum": [
        "medical_officer",
        "radiologist",
        "pharmacist",
        "nurse",
        "lab_scientist",
        "patient",
        "proxy",
        "community_health_worker",
        "therapist",
        "carer",
        "clinical_safety_officer",
        "administrator",
        "researcher",
        "public_health_official",
        "person"
      ],
      "title": "Role",
      "type": "string"
    }
  },
  "$id": "https://atra.local/schemas/apdt/episode_list_item.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "episode": {
      "$ref": "#/$defs/Episode"
    },
    "patient": {
      "anyOf": [
        {
          "$ref": "#/$defs/PatientEntry"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "episode"
  ],
  "title": "EpisodeListItem",
  "type": "object"
}
