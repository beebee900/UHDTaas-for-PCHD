{
  "$defs": {
    "Role": {
      "enum": [
        "medical_officer",
        "radiologist",
        "pharmacist",
        "nurse",
        "lab_scientist",
        "patient",
        "proxy",
        "community_health_worker",
        "therapist",
        "carer",
        "clinical_safety_officer",
        "administrator",
        "researcher",
        "public_health_official",
        "person"
      ],
      "title": "Role",
      "type": "string"
    },
    "WorklistItem": {
      "additionalProperties": false,
      "properties": {
        "due_by": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Due By"
        },
        "episode_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Episode Id"
        },
        "hdt_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hdt Id"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "priority": {
          "default": 3,
          "maximum": 5,
          "minimum": 1,
          "title": "Priority",
          "type": "integer"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "kind",
        "title"
      ],
      "title": "WorklistItem",
      "type": "object"
    }
  },
  "$id": "https://atra.local/schemas/apdt/worklist.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/WorklistItem"
      },
      "title": "Items",
      "type": "array"
    },
    "role": {
      "$ref": "#/$defs/Role"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "role",
    "tenant_id",
    "items"
  ],
  "title": "Worklist",
  "type": "object"
}
