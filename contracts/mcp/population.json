{
  "server": "population",
  "tools": [
    {
      "description": "Condition prevalence priors by age band, sex, region and season",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "age_band": {
            "title": "Age Band",
            "type": "string"
          },
          "conditions": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Conditions",
            "type": "array"
          },
          "region": {
            "title": "Region",
            "type": "string"
          },
          "season": {
            "enum": [
              "dry",
              "rainy"
            ],
            "title": "Season",
            "type": "string"
          },
          "sex": {
            "enum": [
              "female",
              "male"
            ],
            "title": "Sex",
            "type": "string"
          }
        },
        "required": [
          "conditions",
          "age_band",
          "sex",
          "region",
          "season"
        ],
        "title": "PriorsArgs",
        "type": "object"
      },
      "name": "population.priors",
      "outputSchema": {
        "$defs": {
          "ModelRef": {
            "additionalProperties": false,
            "properties": {
              "model_id": {
                "title": "Model Id",
                "type": "string"
              },
              "version": {
                "title": "Version",
                "type": "string"
              }
            },
            "required": [
              "model_id",
              "version"
            ],
            "title": "ModelRef",
            "type": "object"
          },
          "PriorRow": {
            "additionalProperties": false,
            "properties": {
              "age_band": {
                "title": "Age Band",
                "type": "string"
              },
              "condition": {
                "title": "Condition",
                "type": "string"
              },
              "prevalence": {
                "maximum": 1,
                "minimum": 0,
                "title": "Prevalence",
                "type": "number"
              },
              "region": {
                "title": "Region",
                "type": "string"
              },
              "season": {
                "title": "Season",
                "type": "string"
              },
              "source": {
                "title": "Source",
                "type": "string"
              }
            },
            "required": [
              "condition",
              "prevalence",
              "age_band",
              "season",
              "region",
              "source"
            ],
            "title": "PriorRow",
            "type": "object"
          },
          "ToolMeta": {
            "additionalProperties": true,
            "properties": {
              "ahdt_version": {
                "title": "Ahdt Version",
                "type": "string"
              },
              "as_of": {
                "anyOf": [
                  {
                    "format": "date-time",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "As Of"
              },
              "explainers": {
                "anyOf": [
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Explainers"
              },
              "fork_id": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Fork Id"
              },
              "forked": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Forked"
              },
              "models": {
                "items": {
                  "$ref": "#/$defs/ModelRef"
                },
                "title": "Models",
                "type": "array"
              },
              "output_id": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Output Id"
              }
            },
            "required": [
              "ahdt_version"
            ],
            "title": "ToolMeta",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "_meta": {
            "$ref": "#/$defs/ToolMeta"
          },
          "priors": {
            "items": {
              "$ref": "#/$defs/PriorRow"
            },
            "title": "Priors",
            "type": "array"
          }
        },
        "required": [
          "priors"
        ],
        "title": "PriorsData",
        "type": "object"
      }
    },
