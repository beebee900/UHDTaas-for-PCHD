          "text": {
            "title": "Text",
            "type": "string"
          },
          "uncertainty": {
            "additionalProperties": true,
            "title": "Uncertainty",
            "type": "object"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "explanation_id",
          "output_id",
          "model_id",
          "version",
          "explainer",
          "method_family",
          "text"
        ],
        "title": "AHDTExplanation",
        "type": "object"
      }
    },
