            "default": null,
            "title": "Causal Graph Ref"
          },
          "counterfactuals": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/$defs/Counterfactual"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Counterfactuals"
          },
          "drivers": {
            "items": {
              "$ref": "#/$defs/Driver"
            },
            "title": "Drivers",
            "type": "array"
          },
          "explainer": {
            "title": "Explainer",
            "type": "string"
          },
          "explanation_id": {
            "title": "Explanation Id",
            "type": "string"
          },
          "method_family": {
            "enum": [
              "attribution",
              "saliency",
              "counterfactual",
              "sensitivity",
              "rule_trace",
              "ontology_justification",
              "citation",
              "temporal_attribution",
              "graph"
