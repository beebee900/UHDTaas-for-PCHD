            "title": "Method Family",
            "type": "string"
          },
          "model_id": {
            "title": "Model Id",
            "type": "string"
          },
          "output_id": {
            "title": "Output Id",
            "type": "string"
          },
          "quality": {
            "anyOf": [
              {
                "$ref": "#/$defs/ExplanationQuality"
              },
              {
                "type": "null"
              }
            ],
            "default": null
